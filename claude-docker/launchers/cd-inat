#!/usr/bin/env bash
# claude-docker launcher: SBP AI (non-CIS) — inat.
#
# Multi-mount: inat (the repo, and the box's working dir as the first mount)
# plus sbp/ai/kits, read-write. kits is inat's main kit source, and the two
# change together (registry format, delivery behaviour, testing against real
# kits), so mounting it by default saves a `+sbp/ai/kits` on every launch.
# Passing `+sbp/ai/kits` anyway is harmless: run.sh collapses a tree given
# twice into one mount.
#
# Both live on sbp.gitlab, hence --glab.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
cd_workspace "sbp/ai/inat"; inat=$ws
cd_workspace "sbp/ai/kits"; kits=$ws
# sbp.gitlab only: glab's default host and the only host the git credential
# helper offers the token to. run.sh derives neither (no glab-config parse).
export GITLAB_HOST=sbp.gitlab.schubergphilis.com
export CLAUDE_DOCKER_GITLAB_HOSTS=sbp.gitlab.schubergphilis.com
exec "$CD_RUN" --claude-auth --glab "$inat" "$kits" "$@"
