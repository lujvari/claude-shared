#!/usr/bin/env bash
# claude-docker launcher: CIS platform, multi-tenant (ASR + Aegon).
#
# Tenant selection is AWS_PROFILE *inside* the container, not a wrapper flag,
# so one launcher serves both tenants. cd-asr is not an alias for it: that is
# its own launcher, for a.s.r. client (KB) work.
# Mounts only sbp/cis per the CIS convention.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
cd_workspace "sbp/cis"
# sbp.gitlab only: glab's default host and the only host the git credential
# helper offers the token to. run.sh derives neither (no glab-config parse).
export GITLAB_HOST=sbp.gitlab.schubergphilis.com
export CLAUDE_DOCKER_GITLAB_HOSTS=sbp.gitlab.schubergphilis.com
exec "$CD_RUN" --claude-auth --aws --glab "$ws" "$@"
