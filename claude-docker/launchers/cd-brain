#!/usr/bin/env bash
# claude-docker launcher: Brain (personal) - the global backlog service, laslo/brain.
# --braindb forwards BRAIN_TEST_DSN, the brain_test Postgres DSN, from
# 1Password. That DSN carries its password — test instance only.
# Cloudflare credentials only for the deploy phase.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
cd_workspace "laslo/brain"
exec "$CD_RUN" --claude-auth --braindb "$ws" "$@"
