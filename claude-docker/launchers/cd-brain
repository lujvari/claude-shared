#!/usr/bin/env bash
# claude-docker launcher: Brain (personal) - the global backlog service, laslo/brain.
# --braindb forwards BRAIN_TEST_DSN, the laslo_brain_test Postgres DSN, from
# 1Password. That DSN carries its password — test instance only.
# --gh so the box pushes its own commits to Brain's private GitHub origin.
# Cloudflare credentials only for the deploy phase.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
cd_workspace "laslo/brain"

# brain-test-postgres: Brain's own disposable test database, defined in
# laslo/brain/compose.test.yml (loopback 47401; boxes reach it at
# host.docker.internal:47401). Brought up before every launch so --braindb's
# DSN always has something to answer it; `up --wait` is a no-op when it is
# already healthy. Always through `op run`: .env.test holds op:// refs for the
# init passwords, and leaving them unresolved would change the service config
# and make compose recreate the container. Any failure aborts the launch.
# Docker Desktop doesn't fail `up` when 47401 is taken: the container comes up
# healthy with the port silently unpublished, and stays that way after the
# port frees (later `up --wait` calls are no-ops). So check the publication,
# recreate once if it's missing, and abort if that doesn't fix it.
brain_test_db() {
  ( cd "$ws" && op run --env-file=.env.test -- \
      docker compose -f compose.test.yml up -d --wait "$@" ) >&2
}
brain_test_db_published() {
  [ -n "$(docker port brain-test-postgres 5432/tcp 2>/dev/null)" ]
}
brain_test_db
if ! brain_test_db_published; then
  brain_test_db --force-recreate
  if ! brain_test_db_published; then
    printf 'Brain test database unavailable: %s\n' \
      "127.0.0.1:47401 not published (port in use?)" >&2
    exit 1
  fi
fi

exec "$CD_RUN" --claude-auth --gh --braindb "$ws" "$@"
