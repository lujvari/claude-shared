#!/usr/bin/env bash
# claude-docker fleet relaunch: after a reboot, reopen every box in its own
# Windows Terminal tab, resuming its last conversation. Run from WSL inside
# Windows Terminal.
#
# The tabs go into three windows, one per screen quarter on the owner's two
# monitors (Q2 holds the host session, which is not a box). If one named
# cd-q1, cd-q3 or cd-q4 is already open, the tab joins it and nothing moves.
#
# Placement is rough on purpose. With --work or --home a new window opens at
# that desk's point inside its quarter, small enough that its centre stays
# there; the Ctrl+Numpad2 hotkey in the host AutoIt script
# (tools/autoit/MoveWindow.au3) then snaps every terminal to the half of its
# monitor its centre is in, pixel-exact through Windows Snap. wt.exe can only
# size a window in character cells, which never fits a quarter exactly.
# Without a desk flag Windows places the windows; the wrong flag can put one
# off-screen.
#
#   cd-up            every box in the list below, unplaced
#   cd-up mep cis    only those
#   cd-up --work     place new windows for the work desk (--home: home)
#   cd-up --yolo     pass --yolo to every box opened
#
# --yolo is opt-in, never the default: a --yolo box can use every credential
# its launcher mounts without a permission prompt.
#
# Docker and 1Password are checked once, up front: with either missing, every
# box would abort in its own tab instead.
#
# A box whose container is already running is skipped, named or not: a second
# session in it is what makes --continue resume the wrong conversation. Run
# cd-<name> directly for one. The check reads the claude-docker.box label that
# run.sh sets, so it misses containers started before that label existed, and
# a box still starting (its op reads, or a test-DB lock wait) has no
# container yet.
#
# One wt.exe call per box, ~3 s apart. run.sh gives each `op read` 5 s and
# aborts the launch on any failed read; a dozen boxes reading at once at boot
# is how that timeout gets hit.
#
# The tab command is `bash -lic`: -l because ~/bin reaches PATH through
# ~/.profile, -i because the 1Password token pointer is read in ~/.bashrc.
# It contains no `;`, which wt.exe takes as its own subcommand separator even
# inside an argument. `|| true && exec bash` leaves a shell in the tab after
# the box exits or fails, so a failed launch stays visible for a retry.
#
# Known limit: --continue resumes the newest session in the box's working
# directory, so two boxes from one launcher, or a headless `claude -p` run in
# that workspace since, can resume the wrong conversation.
set -euo pipefail

# The fleet, one group per window. Each name is a cd-<name> launcher on PATH.
q1=(apg asr)
q3=(tools dev mep)
q4=(brain cis ct inat)
boxes=("${q1[@]}" "${q3[@]}" "${q4[@]}")

# has <item> <list...>: true when item is one of the list's words.
has() {
  case " ${*:2} " in *" $1 "*) ;; *) return 1 ;; esac
}

# window_of <box>: prints the group (q1|q3|q4) a fleet box belongs to.
window_of() {
  if has "$1" "${q1[@]}"; then echo q1
  elif has "$1" "${q3[@]}"; then echo q3
  elif has "$1" "${q4[@]}"; then echo q4
  fi
}

# geometry_of <desk> <group>: a new window's --pos X,Y (pixels, 40 in from
# the quarter's top-left) and --size COLS,ROWS (cells; 120 is ~1000 px, so
# the centre stays inside a 1280 px quarter). Nothing for a desk not yet set.
# work: two 2560x1440 screens side by side, primary on the left.
geometry_of() {
  case "$1/$2" in
    work/q1) echo "--pos 40,40 --size 120,40" ;;
    work/q3) echo "--pos 2600,40 --size 120,40" ;;
    work/q4) echo "--pos 3880,40 --size 120,40" ;;
  esac
}

docker_wait=${CD_UP_DOCKER_WAIT:-180}
stagger=${CD_UP_STAGGER:-3}

usage="usage: cd-up [--work|--home] [--yolo] [box...]   (default: ${boxes[*]})"
yolo=
desk=
while [ $# -gt 0 ]; do
  case "$1" in
    --yolo) yolo=" --yolo"; shift ;;
    --work|--home)
      if [ -n "$desk" ] && [ "$desk" != "${1#--}" ]; then
        echo "cd-up: --work and --home are exclusive" >&2; echo "$usage" >&2; exit 2
      fi
      desk=${1#--}; shift ;;
    -h|--help) echo "$usage"; exit 0 ;;
    -*) echo "cd-up: unknown option: $1" >&2; echo "$usage" >&2; exit 2 ;;
    *) break ;;
  esac
done

if [ $# -gt 0 ]; then
  unknown=()
  for b in "$@"; do
    has "$b" "${boxes[@]}" || unknown+=("$b")
  done
  if [ ${#unknown[@]} -gt 0 ]; then
    echo "cd-up: unknown box: ${unknown[*]} (known: ${boxes[*]})" >&2
    exit 2
  fi
  boxes=()
  for b in "$@"; do
    has "$b" "${boxes[@]}" || boxes+=("$b")
  done
fi

if [ -n "$desk" ] && [ -z "$(geometry_of "$desk" q1)" ]; then
  echo "cd-up: no $desk placement yet; windows unplaced"
  desk=
fi

waited=0
until docker info >/dev/null 2>&1; do
  if [ "$waited" -ge "$docker_wait" ]; then
    echo "cd-up: Docker did not come up within ${docker_wait}s; is Docker Desktop running?" >&2
    exit 1
  fi
  sleep 2
  waited=$((waited + 2))
done

if ! running=$(docker ps --format '{{.Label "claude-docker.box"}}' 2>/dev/null); then
  echo "cd-up: could not list running boxes (docker ps failed); no tabs opened." >&2
  exit 1
fi
mapfile -t running <<< "$running"
todo=()
for b in "${boxes[@]}"; do
  if has "cd-$b" "${running[@]}"; then
    echo "cd-up: skipped cd-$b (already running)"
  else
    todo+=("$b")
  fi
done
if [ ${#todo[@]} -eq 0 ]; then
  echo "cd-up: nothing to open"
  exit 0
fi

if ! op whoami >/dev/null 2>&1; then
  echo "cd-up: 1Password is not authenticated (op whoami failed); no tabs opened." >&2
  exit 1
fi

first=1
for b in "${todo[@]}"; do
  [ "$first" = 1 ] || sleep "$stagger"
  first=0
  w=$(window_of "$b")
  # Unquoted on purpose: the geometry is two flag/value pairs, or nothing.
  # shellcheck disable=SC2046
  wt.exe -w "cd-$w" $(geometry_of "$desk" "$w") new-tab --title "cd-$b" wsl.exe -e bash -lic "cd-$b$yolo -- --continue || true && exec bash"
  echo "cd-up: opened cd-$b"
done
