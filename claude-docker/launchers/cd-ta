#!/usr/bin/env bash
# claude-docker launcher: Transamerica application assessment (Aegon).
# sbp.gitlab + Git LFS, hence --glab.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
cd_workspace "clients/aegon/ta-application-assessment"
# sbp.gitlab only: glab's default host and the only host the git credential
# helper offers the token to. run.sh derives neither (no glab-config parse).
export GITLAB_HOST=sbp.gitlab.schubergphilis.com
export CLAUDE_DOCKER_GITLAB_HOSTS=sbp.gitlab.schubergphilis.com
exec "$CD_RUN" --claude-auth --glab "$ws" "$@"
